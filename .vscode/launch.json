{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "▶ Run Bot (polling)",
      "type": "python",
      "request": "launch",
      "module": "bot.main",
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/backend/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "▶ Seed Database",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/backend/seed.py",
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/backend/.env",
      "console": "integratedTerminal"
    }
  ]
}
