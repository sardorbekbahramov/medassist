# === TELEGRAM ===
BOT_TOKEN=your_telegram_bot_token_here
WEBHOOK_HOST=https://your-domain.com
WEBHOOK_PATH=/webhook
WEBAPP_PORT=8080

# === DATABASE (PostgreSQL) ===
# For local Docker:
DATABASE_URL=postgresql+asyncpg://medassist:medassist_secret@db:5432/medassist
# For Supabase/Neon, replace with your connection string:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# === REDIS ===
REDIS_URL=redis://redis:6379/0

# === AI — Gemini (bepul, hozircha ishlatiladi) ===
GEMINI_API_KEY=your_gemini_api_key_here

# === AI — Anthropic Claude (keyinroq o'tish uchun) ===
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# === ADMIN ===
# Comma-separated Telegram user IDs who have admin access
ADMIN_IDS=123456789,987654321

# === FRONTEND (Mini App) ===
WEBAPP_URL=https://your-domain.com/app

# === SECURITY ===
# Secret for verifying Telegram Web App data
SECRET_KEY=change_this_to_a_long_random_string
